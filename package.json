{
  "name": "laravel-pwa-dev",
  "private": true,
  "description": "Development tooling for nyoncode/laravel-pwa (not shipped with the Composer package).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:js": "node --test --test-reporter=spec tests/js/*/*.test.mjs",
    "test:e2e": "playwright test",
    "lint:js": "eslint .",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "vitepress": "^1.6.4"
  }
}
