includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Public test helper for applications; the package itself never uses it.
        -
            identifier: trait.unused
            path: src/Testing/InteractsWithPwa.php
        # Public trait for the application's notifiable models.
        -
            identifier: trait.unused
            path: src/Push/HasPushSubscriptions.php
